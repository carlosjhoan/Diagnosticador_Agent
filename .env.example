# --- envío de correo (Azure Communication Services) ---
# DRY_RUN=0 activa el envío real. Sin esa variable todo se guarda en .mail/
DRY_RUN=1

MAIL_FROM="Diagnóstico Steel and Glass <DoNotReply@TU-GUID.azurecomm.net>"
MAIL_HOST=smtp.azurecomm.net
MAIL_PORT=587
# Usuario: <nombre-recurso-ACS>.<App-ID>.<Tenant-ID>
MAIL_USER=
MAIL_PASS=
